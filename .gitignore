# Estado de Terraform: contiene la clave de la base de datos
infra/.terraform/
infra/*.tfstate*
infra/*.tfplan
infra/apply.log

# Capturas con datos de la cuenta o de la conexión
capturas/01_cuenta/
capturas/03_despliegue/
capturas/05_consola/

presentacion/revision/
libreto/
pruebas/mis_resultados.json
node_modules/
.DS_Store

# Ejemplos: mismo criterio que infra/
ejemplos/**/.terraform/
ejemplos/**/*.tfstate*
ejemplos/**/*.tfplan

# Capturas completas de la consola (muestran el número de cuenta)
capturas/06_cloudshell/
capturas/07_manual/
